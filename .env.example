# ── Frontend environment variables ─────────────────────────────────────────
#
# Vercel deployment:
#   Set VITE_API_BASE_URL in Vercel Dashboard → Project → Settings → Environment Variables
#   Value: https://api.yourdomain.com   (your VPS backend URL)
#
# Local development:
#   Leave as http://localhost:8000 — the Vite dev proxy will forward /api calls.
#   You can also set to empty string "" to use the Vite proxy (default).

VITE_API_BASE_URL=http://localhost:8000
